<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     桌面小组件 · 「选择屙屎人」配置向导浮层
     ───────────────────────────────────────────────────────────────────
     两个入口共用同一套界面：
       ① 添加到桌面时的系统配置流程（android:configure）
       ② 点击已放置小组件的成员区（原地换人，无需删掉重加）
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_config_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="选择屙屎人"
        android:textColor="@color/widget_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="这个小组件只显示 TA 的记录与数据"
        android:textColor="@color/widget_ink_3"
        android:textSize="12.5sp" />

    <ScrollView
        android:id="@+id/config_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/config_member_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/config_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/widget_ink_3"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/config_btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_ghost"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="取消"
        android:textColor="@color/widget_ink"
        android:textSize="13.5sp"
        android:textStyle="bold" />
</LinearLayout>
