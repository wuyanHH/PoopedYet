<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 允许应用访问网络与网络状态连接 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 实时如厕灵动胶囊与前台计时通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 应用内更新：下载完 APK 后自行拉起系统安装器。
         Android 8.0+ 上这是一条「特殊权限」——声明只是让系统允许我们发起请求，
         真正放行还要用户在「安装未知应用」里给本应用手动开一次。
         没开时 MainActivity 的 installApk 会返回 NEED_PERMISSION，
         由 Dart 侧引导用户去该设置页，而不是抛一个看不懂的异常。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- android:enableOnBackInvokedCallback 打开 Android 13+ 的「返回事件预测」通道，
         它是预测性返回手势（拖入时预览上一页）的前提 —— 不打开的话系统根本不会把
         手势进度发给 Flutter，Dart 侧的观察者一个回调都收不到。低版本系统会忽略此属性。

         注意：它一旦打开，系统不再调用 Activity.onBackPressed()，返回改由 Flutter 引擎
         统一分发。本项目 MainActivity 没有覆写 onBackPressed，所以不存在被绕过的问题。
         返回键 / 三键导航的返回仍然照常工作：Dart 侧把手势和按键事件分开处理
         （见 PredictiveBackEvent.isButtonEvent），按键事件不会被跟手预览接管。 -->
    <application
        android:label="屙了么"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 桌面小组件 Deep Link 交互路由 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="poopedyet" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件「选择屙屎人」配置向导。
             ① 系统在添加小组件时经 android:configure 拉起（APPWIDGET_CONFIGURE）；
             ② 点击已放置小组件的成员区时由 PendingIntent 原地拉起。
             两者都会带 EXTRA_APPWIDGET_ID，因此共用同一个 Activity。

             刻意不加 noHistory / taskAffinity：配置流程中途被通知栏打断时，
             Activity 若被销毁，系统会判定「配置取消」，用户白选一次。 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.PoopedYet.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 小号桌面小组件 (2×2) 撕历打卡 -->
        <receiver
            android:name=".widget.SmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/small_widget_info" />
        </receiver>

        <!-- 中号桌面小组件 (4×2) 手帐周历 -->
        <receiver
            android:name=".widget.MediumWidgetProvider"
            android:exported="true"
            android:label="@string/widget_medium_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/medium_widget_info" />
        </receiver>

        <!-- 大号桌面小组件 (4×4) 健康工作台与便签流 -->
        <receiver
            android:name=".widget.LargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/large_widget_info" />
        </receiver>

        <!-- 小组件「现在开屙 / 完成打卡」的后台执行接收端。
             这两个动作不该把用户拽进 App：广播进来之后由 WidgetActionRunner
             临时拉一个无界面 FlutterEngine 直接写库，写完刷新桌面。
             exported=false —— 只有本 App 自己创建的 PendingIntent 能触发。 -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- 实时如厕状态栏灵动胶囊 & 锁屏前台计时服务 -->
        <service
            android:name=".service.PoopLiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="poop_live_timer" />
        </service>

        <!-- 本地备份文件安全共享 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 的软件包可见性：不声明这一段，queryIntentActivities
             查不到任何 APK 安装器，installApk 就会把「本机明明有安装器」
             误判成「无法安装」。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
