<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 原生冷启动主题 (第 0 毫秒直接居中展现启动页，无缝衔接 Flutter 启动页) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Android 12+ SplashScreen API 属性：直接展示品牌启动图元，彻底消除纯空白遮盖 -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- 桌面小组件「选择屙屎人」配置向导主题。
         浮层卡片形态：添加小组件时 / 点击小组件成员区时弹出，
         不进入最近任务、不占后台栈，选完即走。 -->
    <style name="Theme.PoopedYet.WidgetConfig" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:colorAccent">@color/widget_brand_fill</item>
    </style>
    <!-- 4×4 底部「本周节律」的一个格子：一格一天，「一3」= 周一 3 次 -->
    <style name="WidgetWeekCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">17dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_cell_normal</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/widget_ink_3</item>
        <item name="android:textSize">9.5sp</item>
    </style>

</resources>
