<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_paper"
    android:padding="13dp">

    <!-- 顶部标题与日期栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_large_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="屙了么 · 家庭健康手帐"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink" />

        <TextView
            android:id="@+id/tv_large_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3月30日 星期一"
            android:textSize="10sp"
            android:textColor="@color/widget_ink_2" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line"
        android:layout_marginBottom="8dp" />

    <!-- 全家成员状态卡片（前 3 位） -->
    <LinearLayout
        android:id="@+id/layout_family_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- 成员 1 -->
        <LinearLayout
            android:id="@+id/card_f_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_cell_normal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="3dp">

            <ImageView
                android:id="@+id/iv_f_avatar_0"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_f_name_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="我"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_f_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="今日1次"
                android:textSize="8.5sp"
                android:textColor="@color/widget_ink_3"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_f_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_soft"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:text="记一次"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_brand_ink" />
        </LinearLayout>

        <!-- 成员 2 -->
        <LinearLayout
            android:id="@+id/card_f_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_cell_normal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <ImageView
                android:id="@+id/iv_f_avatar_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_f_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="咪咪"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_f_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="今晨"
                android:textSize="8.5sp"
                android:textColor="@color/widget_ink_3"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_f_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_soft"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:text="帮记"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_brand_ink" />
        </LinearLayout>

        <!-- 成员 3 -->
        <LinearLayout
            android:id="@+id/card_f_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_cell_normal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:layout_marginStart="3dp">

            <ImageView
                android:id="@+id/iv_f_avatar_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_f_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="宝宝"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_f_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="尚未排便"
                android:textSize="8.5sp"
                android:textColor="@color/widget_ink_3"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/btn_f_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_soft"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:text="补录"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_brand_ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- 近期便签流水 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最新便签速记"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink_2" />

        <TextView
            android:id="@+id/tv_note_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#顺畅"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/widget_brand_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_cell_normal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_note_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐶 我 · 14:15 (用时 11m)"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink" />

        <TextView
            android:id="@+id/tv_note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="喝完温水后排空，感觉非常舒适顺畅。"
            android:textSize="9sp"
            android:textColor="@color/widget_ink_3"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 弹性占位，保证底部按钮始终贴底 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部三动作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal">

        <!-- 极速开屙 (主按钮，包含统一开屙/完成卷纸图标) -->
        <LinearLayout
            android:id="@+id/btn_large_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/bg_btn_brand"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_btn_large_start_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_widget_action_start" />

            <TextView
                android:id="@+id/tv_btn_large_start_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="极速开屙"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_surface" />
        </LinearLayout>

        <!-- 补录便签 -->
        <TextView
            android:id="@+id/btn_large_backfill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_cell_normal"
            android:gravity="center"
            android:text="补录便签"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink" />

        <!-- 打开月历 -->
        <TextView
            android:id="@+id/btn_large_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_cell_normal"
            android:gravity="center"
            android:text="打开日历"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
