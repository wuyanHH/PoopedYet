# 二进制文件绝不能被 git 当文本处理（换行符规范化会把 PNG 写坏）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary

*.ttf   binary
*.woff2 binary
*.otf   binary

*.jar   binary
*.keystore binary
*.jks   binary

# 文本文件统一交给 git 自动判断
* text=auto

# 明确用 LF 的：设计工具链（node / pwsh 都能读，但保持一致省得每次 diff 都炸）
*.mjs   text eol=lf
*.js    text eol=lf
*.ps1   text eol=lf
*.html  text eol=lf
*.dart  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
