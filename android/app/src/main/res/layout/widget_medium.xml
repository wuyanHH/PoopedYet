<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_paper"
    android:padding="12dp">

    <!-- 顶部标题与打卡连击 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tv_medium_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="屙了么 · 便签手帐"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink_3" />

        <TextView
            android:id="@+id/tv_medium_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_soft"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1.5dp"
            android:text="连续顺畅 5 天 ★"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/widget_brand_ink" />
    </LinearLayout>

    <!-- 中部双区分割 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧行动舱 -->
        <LinearLayout
            android:id="@+id/layout_m_action"
            android:layout_width="116dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_m_avatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_m_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="我"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_ink" />

                    <TextView
                        android:id="@+id/tv_m_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今日已打卡"
                        android:textSize="9sp"
                        android:textColor="@color/widget_ink_3" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_m_last_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="距上次: 4h"
                android:textSize="10sp"
                android:textColor="@color/widget_ink_2" />

            <TextView
                android:id="@+id/tv_m_remark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 顺畅无痛"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_3"
                android:maxLines="1"
                android:ellipsize="end" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btn_m_action"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_brand"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_btn_m_action_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_widget_action_start" />

                <TextView
                    android:id="@+id/tv_btn_m_action_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现在开屙"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_surface" />
            </LinearLayout>
        </LinearLayout>

        <!-- 垂直分割细线 -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_line" />

        <!-- 右侧迷你 7 天周历 -->
        <LinearLayout
            android:id="@+id/layout_m_calendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <!-- 7 列日历格 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 星期一 -->
                <LinearLayout
                    android:id="@+id/col_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="一" android:textSize="8.5sp" android:textColor="@color/widget_ink_3" />
                    <LinearLayout android:id="@+id/cell_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_normal" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                        <ImageView android:id="@+id/dot_cell_0" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 星期二 -->
                <LinearLayout
                    android:id="@+id/col_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="二" android:textSize="8.5sp" android:textColor="@color/widget_ink_3" />
                    <LinearLayout android:id="@+id/cell_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_normal" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                        <ImageView android:id="@+id/dot_cell_1" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 星期三 -->
                <LinearLayout
                    android:id="@+id/col_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="三" android:textSize="8.5sp" android:textColor="@color/widget_ink_3" />
                    <LinearLayout android:id="@+id/cell_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_normal" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="26" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                        <ImageView android:id="@+id/dot_cell_2" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 星期四 -->
                <LinearLayout
                    android:id="@+id/col_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="四" android:textSize="8.5sp" android:textColor="@color/widget_ink_3" />
                    <LinearLayout android:id="@+id/cell_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_normal" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                        <ImageView android:id="@+id/dot_cell_3" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:visibility="invisible" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 星期五 -->
                <LinearLayout
                    android:id="@+id/col_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="五" android:textSize="8.5sp" android:textColor="@color/widget_ink_3" />
                    <LinearLayout android:id="@+id/cell_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_normal" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                        <ImageView android:id="@+id/dot_cell_4" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 星期六 -->
                <LinearLayout
                    android:id="@+id/col_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="六" android:textSize="8.5sp" android:textColor="@color/widget_ink_3" />
                    <LinearLayout android:id="@+id/cell_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_normal" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="29" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
                        <ImageView android:id="@+id/dot_cell_5" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 星期日 (今天·高亮) -->
                <LinearLayout
                    android:id="@+id/col_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日" android:textSize="8.5sp" android:textColor="@color/widget_brand_ink" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/cell_6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_cell_today" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tv_cell_num_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/widget_brand_fill" />
                        <ImageView android:id="@+id/dot_cell_6" android:layout_width="5dp" android:layout_height="5dp" android:layout_marginTop="2dp" android:src="@drawable/bg_cell_done" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_medium_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="今日动态：咪咪尚未排便"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_3"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
