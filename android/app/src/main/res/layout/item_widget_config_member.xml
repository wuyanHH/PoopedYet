<?xml version="1.0" encoding="utf-8"?>
<!-- 配置向导的成员行：44dp 头像 + 15.5sp 姓名 + 今日状态，选中态换底并显勾。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_member_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/item_member_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_avatar_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_member_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="我"
            android:textColor="@color/widget_ink"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_member_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="今日 2 次 · 上次 08:30"
            android:textColor="@color/widget_ink_3"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/item_member_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_widget_check"
        android:visibility="invisible" />
</LinearLayout>
