<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件根卡片：现代白卡片 + 24dp 大圆角。
     Android 12+ 会基于 targetSdk 自动为小组件做圆角裁剪与外投影，
     这里的大圆角同时决定了系统裁剪形状，务必与系统默认保持同一量级。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_paper" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_line" />
</shape>
