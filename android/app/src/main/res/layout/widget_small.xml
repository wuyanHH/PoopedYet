<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_paper"
    android:padding="13dp">

    <!-- 顶部打孔撕历头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3月 MARCH"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink_3" />

        <LinearLayout
            android:id="@+id/btn_switch_pooper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_soft"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iv_small_avatar"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_pooper_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_brand_ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中部信息区 (常态 vs 进行中) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 常态布局 -->
        <LinearLayout
            android:id="@+id/layout_normal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_day_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="星期一"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_ink_2" />

                <TextView
                    android:id="@+id/tv_today_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_badge_soft"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="今日 1 次"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_brand_ink" />

                <TextView
                    android:id="@+id/tv_last_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="上次 08:30"
                    android:textSize="9sp"
                    android:textColor="@color/widget_ink_3" />
            </LinearLayout>
        </LinearLayout>

        <!-- 进行中布局 -->
        <LinearLayout
            android:id="@+id/layout_live"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/bg_dot_live" />

                <TextView
                    android:id="@+id/tv_live_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在屙..."
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_live" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/chrono_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/widget_ink" />

            <TextView
                android:id="@+id/tv_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时计时中"
                android:textSize="10sp"
                android:textColor="@color/widget_ink_2" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部操作按钮（包含统一开屙/完成卷纸图标与操作文字） -->
    <LinearLayout
        android:id="@+id/btn_action"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/bg_btn_brand"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_btn_action_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_widget_action_start" />

        <TextView
            android:id="@+id/tv_btn_action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="现在开屙"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/widget_surface" />
    </LinearLayout>
</LinearLayout>
